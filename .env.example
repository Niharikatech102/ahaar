# Server
PORT=3000
NODE_ENV=development

# Twilio WhatsApp Sandbox
# Get these from https://console.twilio.com after joining the WhatsApp sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true to reject webhook calls that fail Twilio signature validation.
# Keep false while testing the webhook through ngrok with a rewritten host.
TWILIO_VALIDATE_SIGNATURE=false

# Public base URL (ngrok) used to build the webhook callback path
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Both of the below are used only to parse free-text search queries
# ("something spicy under 300, not too far") into structured filters. Leave
# both blank to use the built-in keyword parser instead; the bot works fully
# either way. Nothing is bundled or shared - bring your own key.
#
# Anthropic (BYOK - https://console.anthropic.com/settings/keys) - tried
# first when set, since it's the higher-quality option.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Groq (free tier, no credit card - https://console.groq.com/keys) - used as
# a fallback when no Anthropic key is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
