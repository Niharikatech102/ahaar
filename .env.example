# Server
PORT=3000
NODE_ENV=development

# Twilio WhatsApp Sandbox
# Get these from https://console.twilio.com after joining the WhatsApp sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true to reject webhook calls that fail Twilio signature validation.
# Keep false while testing the webhook through ngrok with a rewritten host.
TWILIO_VALIDATE_SIGNATURE=false

# Public base URL (ngrok) used to build the webhook callback path
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
